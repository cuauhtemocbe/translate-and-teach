{
  "name": "translate-and-teach",
  "version": "1.0.0",
  "description": "Translate and Teach - A language learning platform",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "start": "pnpm dev",
    "start:dev": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "validate": "./scripts/validate.sh",
    "prepare": "husky",
    "clean": "rm -rf dist node_modules .pnpm-store",
    "clean:install": "pnpm clean && pnpm install"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.0",
    "vite": "^8.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.19.17",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "esbuild": "0.28.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^16.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "yaml": "2.9.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "bash -c 'cd /app && pnpm run lint'",
      "bash -c 'cd /app && pnpm run typecheck'",
      "bash -c 'cd /app && pnpm run build'"
    ]
  }
}
