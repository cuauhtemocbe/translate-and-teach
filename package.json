{
  "name": "translate-and-teach",
  "version": "1.0.0",
  "description": "Translate and Teach - A language learning platform",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=26.12.1 <27",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "start": "pnpm dev",
    "start:dev": "vite",
    "dev": "vite",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.ts",
    "start:server": "node --env-file-if-exists=.env server/index.ts",
    "build": "tsc && vite build",
    "scan:dist": "node scripts/scan-dist-for-secrets.mjs dist",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "biome check src server",
    "lint:fix": "biome check --write src server",
    "format": "biome format --write src server",
    "format:check": "biome format src server",
    "validate": "./scripts/validate.sh",
    "prepare": "husky",
    "clean": "rm -rf dist node_modules .pnpm-store",
    "clean:install": "pnpm clean && pnpm install"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/jsdom": "30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "esbuild": "0.28.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "yaml": "2.9.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "bash -c 'cd /app && pnpm run lint'",
      "bash -c 'cd /app && pnpm run typecheck'",
      "bash -c 'cd /app && pnpm run build'"
    ]
  }
}
