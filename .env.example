# English Pro - Environment Variables Template
# Copy this file to .env and fill in your actual values

# Together.ai API Key
# Get your API key from: https://api.together.xyz/settings/api-keys
VITE_TOGETHER_API_KEY=your_api_key_here

# Together.ai Model
# Specify which LLM model to use for translations
# Browse models at: https://docs.together.ai/docs/chat-models
# Example: meta-llama/Llama-3.3-70B-Instruct-Turbo
VITE_TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
